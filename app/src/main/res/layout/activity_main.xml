<?xml version="1.0" encoding="utf-8"?>
<!-- filterTouchesWhenObscured: ignore taps while another app draws over this screen, so an
     overlay can't trick anyone into tapping Lock, a switch, New code or Deactivate. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:filterTouchesWhenObscured="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:textAppearance="@android:style/TextAppearance.DeviceDefault.Large" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/status_not_device_owner" />

        <TextView
            android:id="@+id/adb_command"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="monospace"
            android:textIsSelectable="true" />

        <LinearLayout
            android:id="@+id/owner_controls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Closes the open list. Beeswax stays locked. -->
            <Button
                android:id="@+id/close_list"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/lock" />

            <TextView
                android:id="@+id/lock_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/lock_test_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/lock_test_note"
                android:visibility="gone" />

            <!-- Shown as typed, so a long code copied from paper is easy to check. No suggestions,
                 so the keyboard doesn't learn it. -->
            <EditText
                android:id="@+id/code"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:hint="@string/code_hint"
                android:importantForAutofill="no"
                android:inputType="textVisiblePassword|textNoSuggestions" />

            <Button
                android:id="@+id/open_list"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/open_list" />

            <!-- Filled in by MainActivity before the first Lock and while the list is open. -->
            <LinearLayout
                android:id="@+id/app_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <Button
                android:id="@+id/lock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/lock" />

            <Button
                android:id="@+id/new_code"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/new_code" />

            <TextView
                android:id="@+id/backups_failed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/backups_failed"
                android:visibility="gone" />

            <Button
                android:id="@+id/deactivate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/deactivate" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
